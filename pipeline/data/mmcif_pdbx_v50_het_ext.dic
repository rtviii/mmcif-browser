###########################################################################
#  _pdbx_heterogeneity_hierarchy  -- which networks exclude one another
###########################################################################
save_pdbx_heterogeneity_hierarchy
   _category.description
;              One row per heterogeneity network (from PDBX_ALT_GROUPS), assigning it to a
               mutually-exclusive set -- the coexistence group, which is the same thing a
               crystallographer calls an occupancy group. Networks that share a
               coexistence_group_id are alternatives at one site: at most one of them is
               present in any single copy of the structure.

               This category says only what excludes what. It says nothing about which
               networks at DIFFERENT sites occur together, or in what proportion; that is
               the joint distribution, and it is recorded in PDBX_HET_STATE.

               Part of the proposed heterogeneity extension.
;
   _category.id              pdbx_heterogeneity_hierarchy
   _category.mandatory_code  no
   #
   _category_key.name  "_pdbx_heterogeneity_hierarchy.alt_group_id"
   #
   loop_
   _category_group.id
     inclusive_group
   #
save_
#
save__pdbx_heterogeneity_hierarchy.alt_group_id
   _item_description.description
;              The network this row describes. This data item is a pointer to
               _pdbx_alt_groups.alt_group_id.
;
   _item.name            "_pdbx_heterogeneity_hierarchy.alt_group_id"
   _item.category_id     pdbx_heterogeneity_hierarchy
   _item.mandatory_code  yes
   #
   _item_type.code  code
   #
   loop_
   _item_linked.child_name
   _item_linked.parent_name
     "_pdbx_heterogeneity_hierarchy.alt_group_id"  "_pdbx_alt_groups.alt_group_id"
   #
save_
#
save__pdbx_heterogeneity_hierarchy.coexistence_group_id
   _item_description.description
;              Names the mutually-exclusive set this network belongs to. At most one member
               of a coexistence group is present in any one copy of the structure, so their
               marginal occupancies (from _atom_site.occupancy) sum to at most 1; a sum
               below 1 leaves a fraction of copies in which none of them is present.

               A network with no sibling may be left unassigned ('.'), in which case it is
               its own group: present in some copies, absent in the rest.
;
   _item.name            "_pdbx_heterogeneity_hierarchy.coexistence_group_id"
   _item.category_id     pdbx_heterogeneity_hierarchy
   _item.mandatory_code  no
   #
   _item_type.code  code
   #
save_
#
save__pdbx_heterogeneity_hierarchy.state_kind
   _item_description.description
;              What kind of alternative this network is: the same chemical entity in a
               different pose (conformational), or something present in some copies and
               absent in others (compositional). A compositional alternative is the case
               whose 'absent' state has no atoms at all, and so can be named only by a
               network that a state omits -- never by a per-atom label.

               Optional. Part of the proposed heterogeneity extension.
;
   _item.name            "_pdbx_heterogeneity_hierarchy.state_kind"
   _item.category_id     pdbx_heterogeneity_hierarchy
   _item.mandatory_code  no
   #
   _item_type.code  code
   #
   loop_
   _item_enumeration.value
   _item_enumeration.detail
     conformational  "the same entity in a different pose"
     compositional   "an entity present in some copies and absent in others"
     unknown         "not specified by the depositor"
   #
save_
#
###########################################################################
#  _pdbx_het_state  -- the joint: combinations that occur, and how often
###########################################################################
save_pdbx_het_state
   _category.description
;              One row per combination of networks that actually occurs together -- a
               state. A state is a complete joint assignment over the networks of one
               bundle, and its occupancy is the JOINT occupancy of the whole combination:
               the fraction of copies of the structure that are in exactly this state.

               The networks making up a state are listed in PDBX_HET_STATE_MEMBERS, because
               an mmCIF cell holds a single value. A state lists only the networks that are
               PRESENT; a site left empty in that state is spelled by omission.

               This is the information ATOM_SITE cannot hold. _atom_site.occupancy is a
               marginal -- how often one network is present, on its own -- and any number of
               different joint distributions share the same marginals. A network's marginal
               is recovered by summing the occupancy of every state that contains it, so a
               file carrying both must agree with itself.

               Part of the proposed heterogeneity extension.
;
   _category.id              pdbx_het_state
   _category.mandatory_code  no
   #
   _category_key.name  "_pdbx_het_state.id"
   #
   loop_
   _category_group.id
     inclusive_group
   #
save_
#
save__pdbx_het_state.id
   _item_description.description
;              Unique identifier of this state.
;
   _item.name            "_pdbx_het_state.id"
   _item.category_id     pdbx_het_state
   _item.mandatory_code  yes
   #
   _item_type.code  code
   #
save_
#
save__pdbx_het_state.bundle_id
   _item_description.description
;              The bundle this state belongs to -- the unit of correlation. Networks whose
               occupancies are entangled, so that knowing one changes the distribution of
               another, belong to one bundle, and that bundle's states enumerate their joint
               distribution exhaustively: the occupancies of the states sharing a bundle_id
               sum to 1.0, and any combination the bundle does not list has joint occupancy
               zero.

               Networks in different bundles are independent of one another. Their
               occupancies multiply and are never enumerated together, which is what keeps
               the state table local: its size is exponential in the number of mutually
               correlated switches within a single bundle, and linear in the number of
               bundles.
;
   _item.name            "_pdbx_het_state.bundle_id"
   _item.category_id     pdbx_het_state
   _item.mandatory_code  yes
   #
   _item_type.code  code
   #
save_
#
save__pdbx_het_state.occupancy
   _item_description.description
;              The joint occupancy of this state: the fraction of copies of the structure in
               exactly this combination of networks. It is NOT the occupancy of any one
               member -- a member's own occupancy, the number _atom_site.occupancy carries,
               is the sum of the occupancies of every state containing it.

               Within one bundle_id these values sum to 1.0.
;
   _item.name            "_pdbx_het_state.occupancy"
   _item.category_id     pdbx_het_state
   _item.mandatory_code  yes
   #
   _item_type.code  float
   #
   loop_
   _item_range.maximum
   _item_range.minimum
     1.0  0.0
   #
save_
#
save__pdbx_het_state.provenance
   _item_description.description
;              How this state's joint occupancy was arrived at. The distinction is invisible
               in the coordinates -- a fitted population and an asserted one look identical
               once deposited -- and it is what a consumer needs in order to know how much
               weight the number carries.

               Note that for sites far enough apart to scatter independently, a joint
               occupancy is not obtainable from the Bragg data at all: the average density is
               a one-body quantity and carries only marginals. Such a value comes from
               stereochemistry, from a time-resolved experiment, or from classification, and
               this column is where that is recorded.

               Optional. Part of the proposed heterogeneity extension.
;
   _item.name            "_pdbx_het_state.provenance"
   _item.category_id     pdbx_het_state
   _item.mandatory_code  no
   #
   _item_type.code  code
   #
   loop_
   _item_enumeration.value
   _item_enumeration.detail
     fit        "refined against the data as a free parameter"
     restraint  "held by a restraint or constraint during refinement"
     assert     "asserted by the depositor or annotator; no program fitted it"
     measured   "from an independent measurement (time-resolved populations, cryo-EM class populations)"
     unknown    "not specified by the depositor"
   #
save_
#
save__pdbx_het_state.details
   _item_description.description
;              Free text describing this state -- what it is chemically, or why it is rare.
;
   _item.name            "_pdbx_het_state.details"
   _item.category_id     pdbx_het_state
   _item.mandatory_code  no
   #
   _item_type.code  text
   #
save_
#
###########################################################################
#  _pdbx_het_state_members  -- which networks make up each state
###########################################################################
save_pdbx_het_state_members
   _category.description
;              The membership join between states and networks: one row per (state,
               network) pair, because an mmCIF cell holds a single value and a state is a
               set of networks.

               Only the networks PRESENT in the state are listed. A site whose occupant is
               absent in that state contributes no row -- absence is spelled by omission,
               which is also how a state names something that has no atoms to label.

               Part of the proposed heterogeneity extension.
;
   _category.id              pdbx_het_state_members
   _category.mandatory_code  no
   #
   loop_
   _category_key.name
     "_pdbx_het_state_members.state_id"
     "_pdbx_het_state_members.alt_group_id"
   #
   loop_
   _category_group.id
     inclusive_group
   #
save_
#
save__pdbx_het_state_members.state_id
   _item_description.description
;              The state this membership row belongs to. This data item is a pointer to
               _pdbx_het_state.id.
;
   _item.name            "_pdbx_het_state_members.state_id"
   _item.category_id     pdbx_het_state_members
   _item.mandatory_code  yes
   #
   _item_type.code  code
   #
   loop_
   _item_linked.child_name
   _item_linked.parent_name
     "_pdbx_het_state_members.state_id"  "_pdbx_het_state.id"
   #
save_
#
save__pdbx_het_state_members.alt_group_id
   _item_description.description
;              A network present in that state. This data item is a pointer to
               _pdbx_alt_groups.alt_group_id.
;
   _item.name            "_pdbx_het_state_members.alt_group_id"
   _item.category_id     pdbx_het_state_members
   _item.mandatory_code  yes
   #
   _item_type.code  code
   #
   loop_
   _item_linked.child_name
   _item_linked.parent_name
     "_pdbx_het_state_members.alt_group_id"  "_pdbx_alt_groups.alt_group_id"
   #
save_
#
###########################################################################
#  _pdbx_state_coexistence  -- optional: a combination that cannot occur
###########################################################################
save_pdbx_state_coexistence
   _category.description
;              Optional sparse list of forbidden combinations of networks. Each row says
               that two networks may NOT co-occur in the same copy of the structure.

               This is a zero in the joint distribution -- a support constraint, not a
               distribution -- and it is what to write when two networks are otherwise
               independent, no joint populations are known, and one particular pairing is
               impossible (a rotamer that would clash with a partially-occupied water).

               Not needed within a coexistence group, whose members already exclude one
               another, and not needed within a bundle, whose states already forbid by
               omission every combination they do not list. Never write both a bundle and a
               NOT row for the same combination. Absent from most files.

               Part of the proposed heterogeneity extension.
;
   _category.id              pdbx_state_coexistence
   _category.mandatory_code  no
   #
   _category_key.name  "_pdbx_state_coexistence.id"
   #
   loop_
   _category_group.id
     inclusive_group
   #
save_
#
save__pdbx_state_coexistence.id
   _item_description.description
;              Unique identifier of this exclusion rule.
;
   _item.name            "_pdbx_state_coexistence.id"
   _item.category_id     pdbx_state_coexistence
   _item.mandatory_code  yes
   #
   _item_type.code  int
   #
save_
#
save__pdbx_state_coexistence.rule
   _item_description.description
;              The kind of rule. Always NOT: the referenced networks may not co-occur in
               the same physical state. AND and OR are deliberately excluded -- they admit
               several readings, and a combination that is known to occur belongs in
               PDBX_HET_STATE with its population, not in a rule.
;
   _item.name            "_pdbx_state_coexistence.rule"
   _item.category_id     pdbx_state_coexistence
   _item.mandatory_code  yes
   #
   _item_type.code  code
   #
   loop_
   _item_enumeration.value
   _item_enumeration.detail
     NOT  "the referenced networks may not co-occur"
   #
save_
#
save__pdbx_state_coexistence.alt_group_id
   _item_description.description
;              The first network of a forbidden combination. This data item is a pointer to
               _pdbx_alt_groups.alt_group_id.
;
   _item.name            "_pdbx_state_coexistence.alt_group_id"
   _item.category_id     pdbx_state_coexistence
   _item.mandatory_code  yes
   #
   _item_type.code  code
   #
   loop_
   _item_linked.child_name
   _item_linked.parent_name
     "_pdbx_state_coexistence.alt_group_id"  "_pdbx_alt_groups.alt_group_id"
   #
save_
#
save__pdbx_state_coexistence.alt_group_ids
   _item_description.description
;              The network the first may not co-occur with. This data item is a pointer to
               _pdbx_alt_groups.alt_group_id.
;
   _item.name            "_pdbx_state_coexistence.alt_group_ids"
   _item.category_id     pdbx_state_coexistence
   _item.mandatory_code  yes
   #
   _item_type.code  code
   #
   loop_
   _item_linked.child_name
   _item_linked.parent_name
     "_pdbx_state_coexistence.alt_group_ids"  "_pdbx_alt_groups.alt_group_id"
   #
